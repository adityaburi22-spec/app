<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <!-- Logo & Branding -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/feedtrainer_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back"
            android:textColor="#F1F5F9"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to sync your goals and stats"
            android:textColor="#4B6580"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="32dp" />

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#141E30">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Full Name field (sign up only) -->
                <TextView
                    android:id="@+id/labelFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FULL NAME"
                    android:textColor="#3A5070"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="Aditya Jat"
                    android:textColorHint="#2A3D55"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

                <!-- Email label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    android:textColor="#3A5070"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="name@example.com"
                    android:textColorHint="#2A3D55"
                    android:textColor="#CBD5E1"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp" />

                <!-- Password label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    android:textColor="#3A5070"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="••••••••"
                    android:textColorHint="#2A3D55"
                    android:textColor="#CBD5E1"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp" />

                <!-- Error message -->
                <TextView
                    android:id="@+id/tvAuthError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="2dp"
                    android:visibility="gone" />

                <!-- Submit button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitAuth"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Sign In"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    app:backgroundTint="#10B981"
                    app:cornerRadius="25dp" />

                <!-- Toggle auth mode link -->
                <TextView
                    android:id="@+id/tvToggleAuthMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="Don't have an account? Sign Up"
                    android:textColor="#38BDF8"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Divider with OR text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#1E2D3D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OR"
                android:textColor="#2A3D55"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#1E2D3D" />
        </LinearLayout>

        <!-- Continue as Guest -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueGuest"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Continue as Guest"
            android:textSize="13sp"
            android:textColor="#4B6580"
            app:strokeColor="#1E2D3D"
            app:strokeWidth="1dp"
            app:backgroundTint="#00000000"
            app:cornerRadius="24dp" />

    </LinearLayout>
</ScrollView>
