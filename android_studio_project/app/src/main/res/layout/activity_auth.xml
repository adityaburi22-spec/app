<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="40dp">

        <!-- Logo & Branding -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/feedtrainer_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to BetterBrainX"
            android:textColor="@color/brand_dark"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to sync your goals and steer your feed"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp" />

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/brand_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Google Sign In Button (Existing Accounts Only) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogleSignIn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Continue with Google"
                    android:textSize="13sp"
                    android:textColor="@color/brand_dark"
                    android:fontFamily="sans-serif-medium"
                    app:icon="@drawable/ic_google_logo"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@null"
                    app:strokeColor="@color/brand_border"
                    app:strokeWidth="1.5dp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="24dp"
                    android:layout_marginBottom="16dp" />

                <!-- Divider: OR EMAIL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/brand_border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OR EMAIL"
                        android:textColor="@color/brand_text_muted"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/brand_border" />
                </LinearLayout>

                <!-- Full Name field (sign up only) -->
                <TextView
                    android:id="@+id/labelFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FULL NAME"
                    android:textColor="@color/brand_text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="Aditya"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/brand_dark"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

                <!-- Email label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    android:textColor="@color/brand_text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="name@example.com"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/brand_dark"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp" />

                <!-- Password label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    android:textColor="@color/brand_text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="••••••••"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/brand_dark"
                    android:inputType="textPassword"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp" />

                <!-- Error message -->
                <TextView
                    android:id="@+id/tvAuthError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/status_red"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="2dp"
                    android:visibility="gone" />

                <!-- Submit button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitAuth"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Sign In"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-medium"
                    app:backgroundTint="@color/brand_moss"
                    app:cornerRadius="25dp" />

                <!-- Toggle auth mode link -->
                <TextView
                    android:id="@+id/tvToggleAuthMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="Don't have an account? Sign Up"
                    android:textColor="@color/brand_moss_dark"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Divider with OR text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/brand_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEMBERSHIP"
                android:textColor="@color/brand_text_muted"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/brand_border" />
        </LinearLayout>

        <!-- Buy on Website CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVisitWebsite"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Purchase Plan on Website"
            android:textSize="13sp"
            android:textColor="@color/brand_moss_dark"
            app:strokeColor="@color/brand_border"
            app:strokeWidth="1.5dp"
            app:backgroundTint="@color/brand_card_bg"
            app:cornerRadius="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already purchased? Sign in above to activate FeedTrainer."
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
