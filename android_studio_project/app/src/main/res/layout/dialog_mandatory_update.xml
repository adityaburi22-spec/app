<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <!-- Header with Logo and Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/feedtrainer_logo"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvUpdateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update Available"
                android:textColor="@color/brand_dark"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvUpdateVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version v1.0.4 Available"
                android:textColor="@color/status_green"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseUpdateDialog"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="@color/brand_text_muted" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What's New in this Release:"
        android:textColor="@color/brand_dark"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp" />

    <!-- Scrollable Release Notes Container (Max Height 220dp with smooth scroll) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollUpdateNotes"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_stat_card"
        android:padding="12dp"
        android:fadeScrollbars="false"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvUpdateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading release notes..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- Progress bar & percentage (hidden until download starts) -->
    <LinearLayout
        android:id="@+id/layoutUpdateProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressUpdateDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="0"
            android:max="100"
            android:progressTint="@color/status_green" />

        <TextView
            android:id="@+id/tvDownloadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting &amp; Downloading APK... 0%"
            android:textColor="@color/brand_dark"
            android:textSize="11sp"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Pinned Update Action Button (ALWAYS VISIBLE, NEVER PUSHED OFF SCREEN) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartUpdate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="⚡ Download &amp; Install Update"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        app:backgroundTint="@color/brand_moss"
        app:cornerRadius="25dp"
        android:elevation="2dp" />

</LinearLayout>
