<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFloatingWidget"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBubble"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:cardCornerRadius="27dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#0F172A">

        <!-- Outer glowing gradient border ring -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_widget_ring"
            android:padding="2.5dp">

            <!-- Inner Circle with Logo -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_widget_inner">

                <ImageView
                    android:id="@+id/ivWidgetLogo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/feedtrainer_logo"
                    android:scaleType="fitCenter" />
            </FrameLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
