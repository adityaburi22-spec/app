<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#141E30">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Daily Like Cap"
        android:textColor="#F1F5F9"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose how many YouTube Shorts FeedTrainer can like each day to steer your recommendations toward your life goals."
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp" />

    <!-- Quick Presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUICK PRESETS"
        android:textColor="#4B6580"
        android:textSize="10sp"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreset20"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="20"
            android:textSize="12sp"
            android:textColor="#CBD5E1"
            app:strokeColor="#334155"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreset40"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="40"
            android:textSize="12sp"
            android:textColor="#10B981"
            app:strokeColor="#10B981"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreset75"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="75"
            android:textSize="12sp"
            android:textColor="#CBD5E1"
            app:strokeColor="#334155"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreset100"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="100"
            android:textSize="12sp"
            android:textColor="#CBD5E1"
            app:strokeColor="#334155"
            app:strokeWidth="1dp"
            app:cornerRadius="18dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Custom Number Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CUSTOM LIMIT"
        android:textColor="#4B6580"
        android:textSize="10sp"
        android:letterSpacing="0.05"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeColor="#10B981"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginBottom="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCustomCap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="#F1F5F9"
            android:textSize="15sp"
            android:hint="Likes per day (5 - 300)"
            android:textColorHint="#475569" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelCap"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Cancel"
            android:textColor="#94A3B8"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCap"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Save Limit"
            android:textColor="#FFFFFF"
            app:backgroundTint="#10B981"
            app:cornerRadius="21dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>
</LinearLayout>
